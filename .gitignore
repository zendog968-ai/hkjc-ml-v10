# Default-deny: version only source code, documentation, and explicit templates/config.
*

# Keep repository metadata and project documents.
!.gitignore
!*.py
!*.md
!requirements.txt
!new_race_template.json
!odds_overlay_template.json

# Never version data, trained models, generated outputs, logs, or archives.
*.sqlite
*.sqlite3
*.db
*.pkl
*.joblib
*.log
*.zip
*.csv
*.html
*.txt
*.json

# Runtime and tooling artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
.hkjc_live_odds_state.json

# Daily generated input/output files (keep only explicit templates above).
race_card.json
prediction.json
prediction.csv
odds_overlay.json
place_odds_overlay.json
odds_overlay_combined.json
odds_overlay.meta.json

# Generated reports and test artefacts.
*_report.json
*_summary.json
*_prediction.json
*_prediction.csv
*_predictions.csv
backtest_*.json
backtest_*.csv
hardening_*/
no_odds_test_output/
odds_helper_live_test/
odds_place_live_test/
odds_place_test/
dual_market_prediction_test/
hardened_live_odds_test/
hardened_degraded_prediction/

# Explicitly re-include repository configuration after broad file-type ignores.
!requirements.txt
!new_race_template.json
!odds_overlay_template.json

# Pre-race automation runtime artefacts and per-meeting schedule.
pre_race_schedule.json
runtime/
*.lock

# Versioned deployment examples.
!pre_race_schedule.example.json
!cron/
!cron/*.cron

# GitHub Actions current race-day control file (update and commit before each meeting).
!race_day_schedule.json

# Versioned GitHub Actions workflow.
!.github/
!.github/workflows/
!.github/workflows/*.yml
# V10.2 local regression outputs
v102_filter_test.md
v102_*_test.json
v102_*_test.csv
v102_place_validation.json
v102_scheduler_test/

# Versioned read-only Dashboard static sources.
!frontend/
!frontend/*.html
!frontend/*.css
!frontend/*.js

# Versioned SQLite schema definitions; database files remain excluded above.
!schema_overseas_deep_racing.sql

# Versioned overseas 15-event blind-test deployment templates; runtime evidence remains ignored.
!deploy/
!deploy/hkjc-overseas-blindtest.service
!deploy/hkjc-overseas-blindtest.timer
!runtime/overseas_blindtest/
!runtime/overseas_blindtest/active_manifest.example.json

# Versioned candidate-calibration deployment source; all runtime status remains ignored.
!run_overseas_blindtest_with_candidate_audit.sh
!deploy/hkjc-overseas-blindtest.service.d/
!deploy/hkjc-overseas-blindtest.service.d/*.conf
