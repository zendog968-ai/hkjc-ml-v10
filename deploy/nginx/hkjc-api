# HKJC ML V10 read-only API reverse proxy.
# This template listens on HTTP/80 for initial private-network deployment.
# Basic Auth is not transport encryption: use HTTPS before exposing it publicly.

server {
    listen 80;
    listen [::]:80;
    server_name _;

    server_tokens off;
    client_max_body_size 1k;

    access_log /var/log/nginx/hkjc-api.access.log;
    error_log /var/log/nginx/hkjc-api.error.log warn;

    location / {
        # Require a password before every API or OpenAPI request.
        auth_basic "HKJC ML V10 API";
        auth_basic_user_file /etc/nginx/hkjc-api.htpasswd;

        # The service is read-only. Reject state-changing methods at Nginx too.
        limit_except GET HEAD OPTIONS {
            deny all;
        }

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
    }
}
